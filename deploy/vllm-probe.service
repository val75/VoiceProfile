# systemd oneshot that checks vLLM answers the app. Triggered by the timer.
#
#   sudo cp deploy/vllm-probe.service /etc/systemd/system/
#   sudo cp deploy/vllm-probe.timer   /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now vllm-probe.timer
#
# Test it immediately with: sudo systemctl start vllm-probe.service
# See docs/deployment/production-deployment.md (vLLM uptime check).

[Unit]
Description=VoiceProfile vLLM uptime probe
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=cato-user
Group=cato-user
WorkingDirectory=/home/cato-user/VoiceProfile
ExecStart=/home/cato-user/VoiceProfile/deploy/vllm_probe.sh
# Reads LLM_URL, LLM_MODEL, LLM_API_KEY and VLLM_HEALTHCHECK_URL from the app's
# .env (not here: unit environments are readable by any user). See vllm_probe.sh.
