# Runs voiceprofile-backup.service every night.
#
#   sudo systemctl enable --now voiceprofile-backup.timer
#   systemctl list-timers voiceprofile-backup.timer   # confirm next run

[Unit]
Description=Daily VoiceProfile database backup

[Timer]
# 03:30 local time daily. Persistent=true runs a missed backup on next boot
# (e.g. if the box was off overnight).
OnCalendar=*-*-* 03:30:00
Persistent=true

[Install]
WantedBy=timers.target
