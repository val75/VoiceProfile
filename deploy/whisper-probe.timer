# Runs whisper-probe.service every 5 minutes.
#
#   sudo systemctl enable --now whisper-probe.timer
#   systemctl list-timers whisper-probe.timer   # confirm next run

[Unit]
Description=VoiceProfile Whisper uptime probe every 5 minutes

[Timer]
# The healthchecks.io check's Period is a minute longer (6 minutes), so a healthy
# probe that runs a few seconds late doesn't flip the check to "late".
OnCalendar=*:0/5
AccuracySec=10s

[Install]
WantedBy=timers.target
