# systemd unit for the Whisper transcription API. Runs on the DGX.
#
# Install (from the checkout at ~/VoiceProfile):
#   sudo cp whisper_service/whisper.service /etc/systemd/system/whisper.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now whisper
#
# See whisper_service/README.md for the full setup.

[Unit]
Description=Whisper transcription API (uvicorn) for VoiceProfile
After=network-online.target
Wants=network-online.target

[Service]
# The user that owns the checkout and venv (never root).
User=cato-user

# The whisper_service dir inside the repo checkout, so uvicorn imports app:app.
WorkingDirectory=/home/cato-user/VoiceProfile/whisper_service

# WHISPER_API_KEY=<same value as WHISPER_API_KEY in the app's .env>
# The service refuses to start without it. Create it once, outside the repo:
#   sudo install -m 600 -o root -g root /dev/null /etc/whisper.env
#   sudoedit /etc/whisper.env
EnvironmentFile=/etc/whisper.env

# uvicorn from the venv, which lives OUTSIDE the checkout at ~/whisper_service/venv
# (where the first install built it; a venv can't be moved, and rebuilding means
# re-downloading the CUDA torch wheels).
# --host is the DGX's private-network address (check: ip -4 addr | grep 192.168.100),
# never 0.0.0.0: the DGX also has a public IP. Only the app server calls this,
# so nothing on the DGX itself can use localhost:6000.
# Wait for that address first: binding it before the interface is up fails, and
# network-online.target doesn't guarantee it. (Bounded by TimeoutStartSec.)
ExecStartPre=/bin/sh -c 'until ip -4 -o addr show | grep -q " 192.168.100.2/"; do sleep 2; done'
ExecStart=/home/cato-user/whisper_service/venv/bin/uvicorn app:app --host 192.168.100.2 --port 6000

Restart=on-failure
RestartSec=5
# whisper.load_model("medium") loads at startup and takes a while.
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
